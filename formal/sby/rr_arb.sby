# xdma_rr_arb (N = 4): one-hot grant, grant only to requesters,
# starvation freedom (granted within N handshakes).
[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
cover: depth 16

[engines]
prove: abc pdr
cover: smtbmc yices

[script]
read_slang -j 1 -D FORMAL -I. -G N=4 --top xdma_rr_arb xdma_rr_arb.sv xdma_rr_arb_sva.sv xdma_fv_reset.sv bind_rr_arb.sv
prep -top xdma_rr_arb

[files]
../../rtl/xdma_rr_arb.sv
../../sva/xdma_rr_arb_sva.sv
../../sva/xdma_sva_defs.svh
xdma_fv_reset.sv
